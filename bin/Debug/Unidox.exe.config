<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<system.serviceModel>
		<bindings>
			<customBinding>
				<binding name="InvoiceWSPortBinding">
					<textMessageEncoding messageVersion="Soap12" />
					<httpsTransport maxReceivedMessageSize="2147483647" />
				</binding>
				<binding name="QueryDocumentWSPortBinding">
					<textMessageEncoding messageVersion="Soap12" />
					<httpsTransport 
						
						
							  transferMode="Buffered"
							  maxBufferSize="999999999"
							  maxReceivedMessageSize="999999999"
							  authenticationScheme="Anonymous"
							  proxyAuthenticationScheme="Anonymous"
							  useDefaultWebProxy="true"
									
									
									                                  />
				</binding>
			</customBinding>
		</bindings>
		<client>
			<endpoint address="https://servis.univeradonusum.com/InvoiceService/InvoiceWS"
					  binding="customBinding" bindingConfiguration="InvoiceWSPortBinding"
					  contract="ServiceReference1.InvoiceWS" name="InvoiceWSPort" />
			<endpoint address="https://servis.univeradonusum.com/QueryInvoiceService/QueryDocumentWS"
					  binding="customBinding" bindingConfiguration="QueryDocumentWSPortBinding"
					  contract="ServiceReference2.QueryDocumentWS" name="QueryDocumentWSPort" />
		</client>
	</system.serviceModel>
</configuration>
